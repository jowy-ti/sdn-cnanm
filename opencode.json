{
  "$schema": "https://opencode.ai/config.json",
  "lsp": {
    "pyright": {
      "command": [".venv/bin/pyright-langserver", "--stdio"],
      "extensions": [".py", ".pyi"],
      "env": {}
    },
    "ruff": {
      "command": [".venv/bin/ruff", "server"],
      "extensions": [".py"]
    }
  },
  "mcp": {
    "servers": {
      "pyright": {
        "type": "local",
        "command": [
          ".venv/bin/python",
          "scripts/run_jons_mcp_pyright.py",
          "."
        ]
      }
    }
  }
}
